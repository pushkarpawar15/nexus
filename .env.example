# NEXUS local development. Keep emulator project IDs consistent.
NEXUS_ENV=development
NEXUS_STORAGE=firestore
GOOGLE_CLOUD_PROJECT=demo-nexus
FIREBASE_PROJECT_ID=demo-nexus
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Role granted to users who sign in without a nexus_role custom claim.
# One of: viewer, operator, admin. A nexus_role claim always wins.
NEXUS_DEFAULT_ROLE=operator
APPROVED_REPOSITORIES={}
NEXUS_PAY_REPOSITORY_KEY=nexus_pay
WORKSPACE_ROOT=
ATTACHMENTS_ROOT=/tmp/nexus-attachments
ATTACHMENTS_BUCKET=
NEXUS_CODING_ENABLED=false
NEXUS_VALIDATION_ENABLED=false
NEXUS_EXECUTION_BACKEND=local
CLOUD_RUN_EXECUTION_JOB=nexus-execution-worker
CLOUD_RUN_EXECUTION_REGION=asia-south1
CLOUD_RUN_EXECUTION_TIMEOUT_SECONDS=3600
CLOUD_BUILD_VALIDATION_LOCATION=asia-south1
CLOUD_BUILD_VALIDATION_SERVICE_ACCOUNT=
CLOUD_BUILD_SERVICE_AGENT=
CLOUD_BUILD_WORKER_POOL=
CLOUD_BUILD_VALIDATION_TIMEOUT_SECONDS=1200
NEXUS_AI_PERMISSIONS=
CODING_MODEL_TIMEOUT_SECONDS=180
VALIDATION_PYTHON_IMAGE=nexus-payflow-python-validator:local
VALIDATION_NODE_IMAGE=nexus-payflow-node-validator:local

# Vertex AI uses local Application Default Credentials or a service identity.
FIRESTORE_DATABASE=(default)
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
NEXUS_CODING_AGENT=antigravity
GEMINI_CODING_MODEL=gemini-3.8-flash
CODING_MODEL_LOCATION=global
GEMINI_API_KEY=

# GitHub App credentials stay on the backend. Create a 32-byte state secret with:
# openssl rand -hex 32
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_STATE_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# GitHub PATs are entered on the Repositories page and held in backend memory.
# Do not put a PAT in frontend/VITE configuration. This is only a legacy override.
GITHUB_TOKEN=
