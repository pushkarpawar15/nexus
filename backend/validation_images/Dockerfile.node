FROM node:20-slim

WORKDIR /opt/validator/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

ENV PATH="/opt/validator/frontend/node_modules/.bin:${PATH}" \
    NODE_PATH=/opt/validator/frontend/node_modules
WORKDIR /workspace
USER node
ENTRYPOINT ["sh", "-c", "cp -a /workspace/. /tmp/nexus-validation && cp -a /opt/validator/frontend/node_modules /tmp/nexus-validation/frontend/node_modules && workdir=${PWD#/workspace} && cd /tmp/nexus-validation$workdir && exec \"$@\"", "--"]
