FROM python:3.12-slim

WORKDIR /opt/validator
COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-dev.txt ./requirements-dev.txt
RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["sh", "-c", "cp -a /workspace/. /tmp/nexus-validation && workdir=${PWD#/workspace} && cd /tmp/nexus-validation$workdir && exec \"$@\"", "--"]
