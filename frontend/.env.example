# Keep blank to use Vite's same-origin API proxy.
VITE_API_BASE_URL=

# Public Firebase web configuration for the local demo project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nexus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nexus
VITE_FIREBASE_APP_ID=1:000000000000:web:demo-nexus
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
